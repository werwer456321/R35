-- ====================== BẤT TỬ + TẮT HITBOX ======================
local player = game.Players.LocalPlayer
local UIS = game:GetService("UserInputService")

-- Tạo nút
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GodModeButton"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 100
screenGui.Parent = player:WaitForChild("PlayerGui")

local button = Instance.new("TextButton")
button.Name = "ToggleGod"
button.Size = UDim2.new(0, 90, 0, 36)
button.Position = UDim2.new(0.02, 0, 0.45, 0)
button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
button.Text = "Bất tử: TẮT"
button.TextColor3 = Color3.fromRGB(255, 80, 80)
button.TextScaled = true
button.Font = Enum.Font.GothamBold
button.BorderSizePixel = 0
button.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2
stroke.Color = Color3.fromRGB(255, 60, 60)
stroke.Parent = button

-- Biến trạng thái
local godEnabled = false
local connections = {}

local function setGod(char, enabled)
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- Xóa connection cũ
    for _, conn in pairs(connections) do
        conn:Disconnect()
    end
    table.clear(connections)

    if enabled then
        -- Khóa máu
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge

        -- Chặn mất máu
        table.insert(connections, humanoid.HealthChanged:Connect(function()
            if humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = humanoid.MaxHealth
            end
        end))

        -- Chặn chết
        table.insert(connections, humanoid.Died:Connect(function()
            humanoid.Health = humanoid.MaxHealth
        end))

        -- Tắt va chạm (giảm hitbox)
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = false
            end
        end
    else
        -- Trả về bình thường
        humanoid.MaxHealth = 100
        humanoid.Health = 100

        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = true
            end
        end
    end
end

-- Cập nhật nút
local function updateButton()
    if godEnabled then
        button.Text = "Bất tử: BẬT"
        button.TextColor3 = Color3.fromRGB(80, 255, 120)
        stroke.Color = Color3.fromRGB(60, 220, 100)
        button.BackgroundColor3 = Color3.fromRGB(20, 40, 25)
    else
        button.Text = "Bất tử: TẮT"
        button.TextColor3 = Color3.fromRGB(255, 80, 80)
        stroke.Color = Color3.fromRGB(255, 60, 60)
        button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    end
end

-- Bấm nút
button.MouseButton1Click:Connect(function()
    godEnabled = not godEnabled
    updateButton()
    if player.Character then
        setGod(player.Character, godEnabled)
    end
end)

-- Khi spawn lại
player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if godEnabled then
        setGod(char, true)
    end
end)

-- Chạy lần đầu
if player.Character then
    setGod(player.Character, godEnabled)
end

updateButton()
print("✅ Script Bất tử + Tắt Hitbox đã sẵn sàng")
