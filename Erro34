-- ========== HÀM KÉO NÚT ==========
local function makeDraggable(btn)
    local dragging = false
    local dragStart, startPos

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = btn.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            btn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

makeDraggable(godBtn)
makeDraggable(hitboxBtn)

-- ========== BẤT TỬ ==========
local function setGod(char, enabled)
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    for _, conn in pairs(connections) do
        conn:Disconnect()
    end
    table.clear(connections)

    if enabled then
        humanoid.MaxHealth = math.huge
        humanoid.Health = math.huge

        table.insert(connections, humanoid.HealthChanged:Connect(function()
            if humanoid.Health < humanoid.MaxHealth then
                humanoid.Health = humanoid.MaxHealth
            end
        end))

        table.insert(connections, humanoid.Died:Connect(function()
            humanoid.Health = humanoid.MaxHealth
        end))

        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = false
            end
        end
    else
        humanoid.MaxHealth = 100
        humanoid.Health = 100

        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanTouch = true
            end
        end
    end
end

-- ========== XEM HITBOX ==========
local function updateHitboxVisual(char, enabled)
    if not char then return end

    if enabled then
        originalColors = {}
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                originalColors[part] = {
                    Color = part.Color,
                    Transparency = part.Transparency,
                    Material = part.Material
                }
                part.Color = Color3.fromRGB(0, 255, 120) -- xanh sáng
                part.Transparency = 0.45
                part.Material = Enum.Material.Neon
            end
        end
    else
        for part, data in pairs(originalColors) do
            if part and part.Parent then
                part.Color = data.Color
                part.Transparency = data.Transparency
                part.Material = data.Material
            end
        end
        table.clear(originalColors)
    end
end

-- ========== CẬP NHẬT GIAO DIỆN ==========
local function updateUI()
    if godEnabled then
        godBtn.Text = "Bất tử: BẬT"
        godBtn.TextColor3 = Color3.fromRGB(80, 255, 120)
        godStroke.Color = Color3.fromRGB(60, 220, 100)
        godBtn.BackgroundColor3 = Color3.fromRGB(20, 40, 25)

        hitboxBtn.Visible = false -- ẩn khi bất tử
        if showHitbox then
            showHitbox = false
            updateHitboxVisual(player.Character, false)
        end
    else
        godBtn.Text = "Bất tử: TẮT"
        godBtn.TextColor3 = Color3.fromRGB(255, 90, 90)
        godStroke.Color = Color3.fromRGB(255, 70, 70)
        godBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

        hitboxBtn.Visible = true
    end

    if showHitbox then
        hitboxBtn.Text = "Xem Hitbox: BẬT"
        hitboxBtn.TextColor3 = Color3.fromRGB(80, 255, 180)
        hitStroke.Color = Color3.fromRGB(60, 220, 160)
        hitboxBtn.BackgroundColor3 = Color3.fromRGB(15, 35, 30)
    else
        hitboxBtn.Text = "Xem Hitbox: TẮT"
        hitboxBtn.TextColor3 = Color3.fromRGB(120, 180, 255)
        hitStroke.Color = Color3.fromRGB(80, 140, 255)
        hitboxBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 40)
    end
end

-- ========== SỰ KIỆN NÚT ==========
